# Copy to .env and fill in. Never commit .env.

# --- LINZ Basemaps -----------------------------------------------------------
# Required for the web map background. Register a free key at
# https://basemaps.linz.govt.nz/  ->  "Get an API key".
# Do NOT use the example/demo key published in LINZ documentation.
VITE_LINZ_API_KEY=replace_me

# --- LINZ Data Service -------------------------------------------------------
# A SEPARATE key from the Basemaps one above. Required to read the official
# NZ Roads Subsections (Addressing) dataset, which is the preferred source for
# road names where AMDS has none - AMDS itself covers only 35.6% of vehicle
# links. Register at https://data.linz.govt.nz/ under "Web services".
#
# Server-side only: this must never reach the browser, so it has no VITE_
# prefix. See docs/ROAD_NAME_SOURCES.md.
LINZ_LDS_API_KEY=replace_me

# --- AMDS source (discovered values; override only if NZTA republishes) -------
AMDS_ITEM_ID=f955c118272b462e9ce757405890b87f
AMDS_FEATURE_SERVICE_URL=https://services.arcgis.com/CXBb7LAjgIIdcsPt/arcgis/rest/services/AMDS_NetworkModel_PROD/FeatureServer
AMDS_LINK_LAYER_ID=1
AMDS_RESTRICTED_TURN_TABLE_ID=9
AMDS_AUTHORITY_TABLE_ID=2
AMDS_ROUTENAME_TABLE_ID=13

# --- Application -------------------------------------------------------------
# The FastAPI backend port. The browser never sees this: it calls relative URLs
# and Vite proxies them here, so there is exactly one backend address.
API_PORT=8000

# Only set VITE_API_BASE_URL to point a build at a REMOTE deployment. Leaving it
# unset keeps the client same-origin, which is what you want locally.
# VITE_API_BASE_URL=https://example.internal

APPLICATION_BASE_URL=http://localhost:5173

# The TypeScript reference engine, used only for cross-validation.
REFERENCE_API_PORT=8788

# Directory holding snapshots and exports. Relative paths resolve against the
# repository root, not the working directory.
DATA_DIR=./data
