{
  "name": "nz-critical-links",
  "private": true,
  "version": "0.1.0",
  "description": "New Zealand road-network criticality and detour analysis, built on the NZTA AMDS Network Model",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/core",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "tsc -b packages/core apps/api && npm run typecheck:web && npm run build --workspace apps/web",
    "typecheck": "tsc -b packages/core apps/api --pretty && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "discover": "tsx pipelines/discovery/discover.ts",
    "ingest": "tsx pipelines/ingestion/ingest.ts",
    "build-graph": "tsx pipelines/topology/build-graph.ts",
    "qa": "tsx pipelines/validation/qa.ts",
    "detours": "tsx pipelines/detours/compute-all.ts",
    "export": "tsx pipelines/detours/export.ts",
    "web": "npm run dev --workspace apps/web",
    "reference-api": "tsx apps/api/src/server.ts",
    "decode-tile": "python scripts/decode-tile.py",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:all": "npm run typecheck && vitest run && playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "exceljs": "^4.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
